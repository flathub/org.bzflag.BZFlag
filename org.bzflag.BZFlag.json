{
  "id": "org.bzflag.BZFlag",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "bzflag",
  "rename-icon": "bzflag",
  "rename-desktop-file": "bzflag.desktop",
  "finish-args": [
    "--socket=pulseaudio",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=all",
    "--share=network",
    "--share=ipc",
    "--persist=.bzf",
    "--env=SDL_VIDEODRIVER=wayland,x11"
  ],
  "modules": [
    "shared-modules/glu/glu-9.json",
    "shared-modules/glew/glew.json",
    {
      "name": "c-ares",
      "buildsystem": "cmake",
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/c-ares/c-ares",
          "commit": "c7a3138dcfe3bb0eaaf10c0c24c36dc66dc790ab",
          "tag": "v1.34.8",
          "x-checker-data": {
            "type": "git",
            "tag-pattern": "^v([\\d.]+)$"
          }
        }
      ]
    },
    {
      "name": "bzflag",
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/BZFlag-Dev/bzflag",
          "commit": "b57eef3d19386497cd654ecd13bb2fe7a7a0b0de",
          "tag": "v2.4.30",
          "x-checker-data": {
            "type": "git",
            "tag-pattern": "^v([\\d.]+)$"
          }
        },
        {
          "type": "patch",
          "path": "patches/70f68508dd188ee8670d3a29b38a3cae13ada2db.patch"
        },
        {
          "type": "file",
          "path": "org.bzflag.BZFlag.appdata.xml"
        }
      ],
      "post-install": [
        "install -Dm644 data/bzflag.desktop /app/share/applications/bzflag.desktop",
        "desktop-file-edit --set-key=Exec --set-value=bzflag /app/share/applications/bzflag.desktop",
		"desktop-file-edit --set-key=Icon --set-value=bzflag /app/share/applications/bzflag.desktop",
        "install -Dm644 misc/art/bzicon-red.svg /app/share/icons/hicolor/scalable/apps/bzflag.svg",
        "install -Dm644 org.bzflag.BZFlag.appdata.xml /app/share/appdata/org.bzflag.BZFlag.appdata.xml"
      ]
    }
  ]
}

{
    "id": "org.bzflag.BZFlag",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "26.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "bzflag",
    "rename-icon": "bzicon-red",
    "rename-desktop-file": "bzflag.desktop",
    "finish-args": [
        "--socket=pulseaudio",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--device=all",
        "--share=network",
        "--share=ipc",
        "--persist=.bzf",
        "--env=SDL_VIDEODRIVER=wayland,x11"
    ],
    "cleanup": [
        "/include",
        "/lib/cmake",
        "/lib/pkgconfig",
        "/share/man"
    ],
    "modules": [
        "shared-modules/glu/glu-9.json",
        "shared-modules/glew/glew.json",
        {
            "name": "c-ares",
            "buildsystem": "cmake",
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/c-ares/c-ares",
                    "commit": "bc91829cce983a35ec01f5dbc05465858a3df469",
                    "tag": "v1.34.9",
                    "x-checker-data": {
                        "type": "git",
                        "tag-pattern": "^v([\\d.]+)$"
                    }
                }
            ]
        },
        {
            "name": "bzflag",
            "post-install": [
                "install -Dm644 data/bzflag.desktop -t /app/share/applications/",
                "install -Dm644 org.bzflag.BZFlag.appdata.xml -t /app/share/metainfo/",
                "install -Dm644 misc/art/bzicon-red.svg -t /app/share/icons/hicolor/scalable/apps/",
                "desktop-file-edit --set-key=Exec --set-value=bzflag /app/share/applications/bzflag.desktop"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/BZFlag-Dev/bzflag",
                    "commit": "f11f05485d7406c78159aac00ace3c58b4b17ec2",
                    "tag": "v2.4.32",
                    "x-checker-data": {
                        "type": "git",
                        "tag-pattern": "^v([\\d.]+)$"
                    }
                },
                {
                    "type": "file",
                    "path": "org.bzflag.BZFlag.appdata.xml"
                }
            ]
        }
    ]
}
